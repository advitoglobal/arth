# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel
# Hosted DATABASE_URL lives only in a local vercel.json at deploy time.
/vercel.json

# typescript
*.tsbuildinfo
next-env.d.ts

# local agent scratch
/agent-tools
/.cursor
/docs/directors-review/node_modules
/docs/directors-review/*.zip
