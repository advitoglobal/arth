DATABASE_URL=postgres://arth_app:arth_local_dev_only@127.0.0.1:5432/arth

# Neon / Vercel: set DATABASE_URL in the host, never in git.
# db:hosted accepts the pooled Neon URI and switches to the compute host.
# Vercel uses the pooled arth_app URI.

